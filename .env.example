# Copy this file to .env and replace the secret before deploying.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Bind to all interfaces when running in a container or hosted environment.
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Set this to true when serving the app over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
